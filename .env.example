# Copy to .env.local for local development, and add the same keys in Vercel
# (Project > Settings > Environment Variables).

# Public site address, used in email links and Stripe redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase > Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend > API Keys. The from-address domain must be verified in Resend.
RESEND_API_KEY=
RESEND_FROM=Auric 280 Club <bookings@auricperformance.co.uk>
# Optional: who gets a copy of each booking/cancellation
CLUB_NOTIFY_EMAIL=info@auricperformance.co.uk

# Stripe > Developers > API keys / Webhooks. Leave blank until Stripe is set up:
# locally, bookings then confirm without payment; in production, booking is paused.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Coach sign-in for /admin: allowed emails (comma separated) and one shared password.
# After the password, a one-time code is emailed to the coach.
CLUB_ADMIN_EMAILS=coach@example.com,another@example.com
CLUB_ADMIN_PASSWORD=

# Long random string that signs customer and coach sign-in sessions and codes.
# Required: without it nobody can sign in. Changing it signs everyone out.
CLUB_SESSION_SECRET=

# Coaches who can see health screening answers and record reviews (comma separated)
CLUB_HEALTH_REVIEWERS=coach@example.com
# Optional: where "screening review needed" alerts go (defaults to the health contact in config.ts)
CLUB_HEALTH_ALERT_EMAIL=

# Set to true once the 280 Club privacy notice is published. Until then the live
# site won't take bookings, because they collect health information.
CLUB_PRIVACY_NOTICE_READY=

# Vercel Cron sends this as a bearer token to /api/280-club/cron
CRON_SECRET=
