# Copy to .env.local for local development, and add the same keys in Vercel
# (Project > Settings > Environment Variables).

# Public site address, used in email links and Stripe redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase > Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend > API Keys. The from-address domain must be verified in Resend.
RESEND_API_KEY=
RESEND_FROM=Auric 280 Club <bookings@auricperformance.co.uk>
# Optional: who gets a copy of each booking/cancellation
CLUB_NOTIFY_EMAIL=info@auricperformance.co.uk

# Stripe > Developers > API keys / Webhooks. Leave blank until Stripe is set up:
# locally, bookings then confirm without payment; in production, booking is paused.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Coach sign-in for /admin: allowed emails (comma separated) and one shared password
CLUB_ADMIN_EMAILS=coach@example.com,another@example.com
CLUB_ADMIN_PASSWORD=

# Vercel Cron sends this as a bearer token to /api/280-club/cron
CRON_SECRET=
